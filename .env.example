AQ_PORTFOLIO_DB_PATH=backend/app/data/portfolio_demo.sqlite3
AQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AQ_ENV=development
AQ_AUTH_REQUIRED=false
AQ_ALLOW_REGISTRATION=true
AQ_AUTH_SECRET=development-only-change-me-before-production
AQ_AUTH_TOKEN_TTL_SECONDS=28800
AQ_RATE_LIMIT_PER_MINUTE=120
AQ_MAX_REQUEST_BYTES=1048576
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=deterministic

# Appendix D - operational complexity (0-100)
AQ_COMPLEXITY_CONFIG_VERSION=operational-complexity-v1
AQ_COMPLEXITY_PROVIDER_WEIGHT=24
AQ_COMPLEXITY_PRODUCT_WEIGHT=16
AQ_COMPLEXITY_FRAGMENT_WEIGHT=22
AQ_COMPLEXITY_MATURITY_WEIGHT=10
AQ_COMPLEXITY_FRAGMENT_THRESHOLD_PCT=0.12
AQ_COMPLEXITY_NORMALIZATION_RAW=250
AQ_COMPLEXITY_WARNING_THRESHOLD=55
AQ_COMPLEXITY_SMALL_CAPITAL_THRESHOLD=50000000
AQ_COMPLEXITY_SMALL_CAPITAL_MULTIPLIER=2.5
AQ_COMPLEXITY_OBJECTIVE_SCALE=2
AQ_COMPLEXITY_RESOLVE_BOOST=25